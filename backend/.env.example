# 复制成 .env 后填本机值。.env 已在 .gitignore 里，不会进仓库。
#
# ⚠️ 只能连 gaokao3。不要连 gaokao（已冻结的历史库）或 gaokao2（缺 poi_transport 等表）。
#    app/config.py 里对库名做了硬校验，连 gaokao 会直接启动失败。

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=gaokao3
PGUSER=postgres
PGPASSWORD=

# 连接池（V1 只读，小池子够用）
PG_POOL_MIN=1
PG_POOL_MAX=8

# 前端开发服务器地址，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
