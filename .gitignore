# ============================================================
# 密钥与本地配置 —— 绝对禁止提交
# ============================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# ============================================================
# 数据库备份 / 导出 —— 体积巨大
# 本机存在 gaokao2_full_20260915.sql 约 1.27 GB，一次 git add . 就会写进
# history，之后必须重写历史才能删掉。不要解开下面任何一条。
# ============================================================
*.sql.gz
*.sql.bz2
*.dump
*.backup
*.bak
gaokao*.sql
*_full_*.sql

# ============================================================
# 空间原始数据 —— 走网盘共享，不进仓库
# ============================================================
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.sbn
*.sbx
*.gpkg
*.kml
*.kmz
*.tif
*.tiff
*.img
*.geojson

# 例外：Mock 小样例（几 KB）可以进仓库
!frontend/src/mocks/*.geojson
!backend/tests/fixtures/*.geojson

# ============================================================
# Python / FastAPI
# ============================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# ============================================================
# Node / Vue
# ============================================================
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# 编辑器 / 系统
# ============================================================
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# 运行产物
# ============================================================
*.log
logs/
tmp/
exports/
